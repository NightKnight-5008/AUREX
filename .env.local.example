# AUREX Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL
VITE_API_URL=http://localhost:3001

# Environment
VITE_ENV=development

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI API Configuration (required for AI chat features)
VITE_AI_API_ID=your-api-id-here
VITE_AI_API_PATH=/v1/ai/your-path/chat/completions
VITE_AI_API_NAME=OpenAIGPTChat

# Google OAuth (optional - for Google integrations)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth-callback.html

# Tenant ID (optional - for multi-tenant deployments)
# TENANT_ID=
