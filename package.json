{
  "name": "aurex",
  "version": "1.0.0",
  "description": "AUREX - Advanced Financial Management Platform",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js --port 3000",
    "start": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js --port 3000",
    "build": "npm run check:safe && set \"NODE_OPTIONS=--max-old-space-size=1792\" && vite build",
    "build:skip-check": "set \"NODE_OPTIONS=--max-old-space-size=8192\" && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "check": "tsgo --noEmit && npm run format",
    "check:safe": "npm run check",
    "format": "biome check --write --unsafe",
    "format:quiet": "biome check --write --unsafe --log-level=warn",
    "lint:mcp": "eslint src --config config/eslint/eslint.mcp.config.js",
    "lint:validate": "node config/eslint/validate-configs.js",
    "prepare": "echo Skipping git hooks setup on Windows",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:compile:watch": "tsc -p desktop/tsconfig.json --watch",
    "desktop:dev": "concurrently -k \"set \\\"NODE_ENV=development\\\" && npm run dev\" \"cd backend && npm run dev\" \"wait-on http://localhost:3000 && wait-on http://localhost:3001/health && set \\\"NODE_ENV=development\\\" && node --max-old-space-size=4096 ./node_modules/electron/cli.js .\"",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:package": "electron-builder --dir",
    "desktop:package:win": "set \"ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/\" && electron-builder --win",
    "desktop:package:mac": "electron-builder --mac",
    "desktop:package:linux": "electron-builder --linux",
    "desktop:package:all": "electron-builder -mwl"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@hookform/resolvers": "^5.0.1",
    "@protobuf-ts/runtime": "^2.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.80.3",
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-router-devtools": "^1.114.3",
    "@tanstack/router-plugin": "^1.114.3",
    "better-sqlite3": "^9.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.476.0",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "openapi-fetch": "^0.14.0",
    "openapi-react-query": "^0.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.57.0",
    "react-resizable-panels": "^3.0.2",
    "recharts": "^2.15.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^3.25.50",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/plugin-syntax-typescript": "^7.27.1",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@babel/plugin-transform-react-jsx-development": "^7.27.1",
    "@biomejs/biome": "2.3.1",
    "@electron/rebuild": "^4.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.2.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@typescript/native-preview": "^7.0.0-dev.20251027.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.6.0",
    "jsdom": "^26.0.0",
    "madge": "^8.0.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.11",
    "vite-plugin-babel": "^1.3.2",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.3",
    "web-vitals": "^4.2.4"
  },
  "overrides": {},
  "build": {
    "appId": "com.aurex.desktop",
    "productName": "AUREX Financial OS",
    "copyright": "Copyright © 2024 AUREX",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*.js",
      "desktop/**/*.json",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "AUREX Inc.",
      "verifyUpdateCodeSignature": false,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.finance",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build-resources/icon.png",
      "category": "Office;Finance"
    },
    "publish": {
      "provider": "github",
      "owner": "aurex",
      "repo": "aurex-desktop"
    }
  }
}
