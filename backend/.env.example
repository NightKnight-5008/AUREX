# AUREX Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/aurex_db

# JWT Secret (REQUIRED - use a strong random string, minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Encryption Key (REQUIRED - 32 characters for AES-256-CBC)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# WhatsApp Configuration (Optional - for payment reminders)
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_KEY=
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# Admin Configuration
# Set this to create admin users via CLI or migration
ADMIN_EMAIL=admin@example.com

# AI API (OpenAI-compatible chat completion proxy for /api/ai/chat)
# AI_API_ID   - API identifier   (sent as X-CREAO-API-ID header)
# AI_API_PATH - API path         (sent as X-CREAO-API-PATH header)
# AI_API_NAME - API name         (sent as X-CREAO-API-NAME header, default OpenAIGPTChat)
AI_API_ID=
AI_API_PATH=
AI_API_NAME=OpenAIGPTChat
# Optional overrides
AI_API_BASE_URL=https://api-production.creao.ai/execute-apis/v2
AI_DEFAULT_MODEL=MaaS_4.1
