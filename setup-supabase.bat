@echo off
REM AUREX Supabase Database Setup Script for Windows

echo ========================================
echo AUREX Supabase Database Setup
echo ========================================
echo.

REM Check if backend/.env exists
if exist "backend\.env" (
    echo ⚠️  backend\.env already exists!
    echo.
    set /p OVERWRITE="Do you want to overwrite it? (y/n): "
    if /i not "%OVERWRITE%"=="y" (
        echo Setup cancelled.
        pause
        exit /b
    )
)

echo.
echo 📝 Please provide your Supabase details:
echo.
echo 1. Go to https://supabase.com
echo 2. Create a new project (if you haven't)
echo 3. Go to Settings -^> Database
echo 4. Copy the Connection String (URI format)
echo.

set /p DATABASE_URL="Enter your Supabase DATABASE_URL: "

if "%DATABASE_URL%"=="" (
    echo ❌ DATABASE_URL cannot be empty!
    pause
    exit /b 1
)

echo.
echo 🔐 Generating secure secrets...

REM Generate random JWT secret (simple version for Windows)
set JWT_SECRET=%RANDOM%%RANDOM%%RANDOM%%RANDOM%%RANDOM%

REM Generate random encryption key (32 chars)
set ENCRYPTION_KEY=aurex_key_%RANDOM%%RANDOM%%RANDOM%_secure

echo.
echo 📄 Creating backend/.env file...

(
echo # AUREX Backend Environment Variables
echo # Generated by setup-supabase.bat
echo.
echo # Database
echo DATABASE_URL=%DATABASE_URL%
echo.
echo # JWT Secret
echo JWT_SECRET=%JWT_SECRET%
echo.
echo # Server
echo PORT=3001
echo NODE_ENV=development
echo.
echo # Frontend URL
echo FRONTEND_URL=http://localhost:3000
echo.
echo # Encryption Key
echo ENCRYPTION_KEY=%ENCRYPTION_KEY%
) > backend\.env

echo ✅ backend/.env created successfully!
echo.

REM Check if .env.local exists
if not exist ".env.local" (
    echo 📄 Creating .env.local file...
    (
    echo # AUREX Frontend Environment Variables
    echo.
    echo # Backend API URL
    echo VITE_API_URL=http://localhost:3001
    echo.
    echo # Environment
    echo VITE_ENV=development
    ) > .env.local
    echo ✅ .env.local created successfully!
    echo.
)

echo.
echo 🚀 Starting backend server to initialize database...
echo.

cd backend
call npm start

echo.
echo ========================================
echo Setup Complete!
echo ========================================
echo.
echo ✅ Database configured
echo ✅ Backend environment ready
echo ✅ Tables will be created automatically
echo.
echo 📍 Next steps:
echo 1. Backend should be running on http://localhost:3001
echo 2. Test health: http://localhost:3001/health
echo 3. Start frontend: npm run dev
echo.
pause
